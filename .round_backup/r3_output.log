rows=con.execute(\"\"\"
SELECT a.src_doc_id, d.loai_van_ban, a.op, a.target_so_ky_hieu, a.target_dieu, a.evidence_text
FROM amendments a JOIN documents d ON d.doc_id=a.src_doc_id
WHERE a.op='EXPIRE' AND a.target_so_ky_hieu IS NULL
ORDER BY a.src_doc_id
\"\"\").fetchall()
types=sorted({r[1] for r in rows if r[1]}, key=len, reverse=True)
