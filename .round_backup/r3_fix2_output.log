old_db = r'D:\\tmp\\legal_sample_200_old_extract.duckdb'
new_db = r'legal_sample_200.duckdb'
case_sql = \"\"\"
select src_doc_id, op, target_so_ky_hieu, target_dieu, target_khoan, target_diem, left(evidence_text,260) as evidence
from amendments
where (src_doc_id='616621' and op='REPEAL' and target_dieu='6')
   or (src_doc_id='694652' and op='EXPIRE' and target_so_ky_hieu in ('1598/QĐ-UBND','991/QĐ-UBND'))
   or (src_doc_id='586814' and op='EXPIRE' and target_so_ky_hieu='21/2017/QH15' and target_dieu='58')
order by src_doc_id, op, target_so_ky_hieu, target_dieu, evidence
\"\"\"
for db in [old_db, new_db]:
    con=duckdb.connect(db, read_only=True)
    print('\\nDB', db)
    print('total_amendments', con.execute('select count(*) from amendments').fetchone()[0])
    rows=con.execute(case_sql).fetchall()
    print('case_rows', len(rows))
    for r in rows:
        print(' | '.join('' if x is None else str(x) for x in r[:6]))
        print('  ' + r[6].replace('\\n',' '))
    con.close()

self_ref = re.compile(
    \"(Lu\\u1eadt|Ngh\\u1ecb \\u0111\\u1ecbnh|Ngh\\u1ecb quy\\u1ebft|\"
    \"Quy\\u1ebft \\u0111\\u1ecbnh|Th\\u00f4ng t\\u01b0|Ph\\u00e1p l\\u1ec7nh)\"
    \"\\\\s+n\\u00e0y\\\\s+(?:c\\u00f3 hi\\u1ec7u l\\u1ef1c|\\u0111\\u01b0\\u1ee3c th\\u00f4ng qua)\",
    re.I,
)
con=duckdb.connect(new_db, read_only=True)
rows=con.execute(\"\"\"
select src_doc_id, op, target_so_ky_hieu, target_dieu, evidence_text
from amendments
where op in ('EXPIRE','SUSPEND') and target_so_ky_hieu is null and target_dieu is null
\"\"\").fetchall()
pure=[r for r in rows if self_ref.search(r[4])]
print('\\nnew pure_boilerplate_self_ref_no_target', len(pure))
con.close()
