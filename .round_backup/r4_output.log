        "path_prefix": "main",
        "starts_at_ord": 0,
        "ends_at_ord": len(seg["body"]) - 1 if seg["body"] else None,
        "raw_heading": None,
    }]
    if seg["appendix"]:
        parts.append({
            "part_id": f"{doc_id}:appendix:1",
            "doc_id": doc_id,
