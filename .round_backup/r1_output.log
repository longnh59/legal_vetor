            JOIN _resolve_docs_{table} rd ON rd.rid = r.rid
            JOIN provisions p
              ON p.doc_id = rd.doc_id
             AND coalesce(p.source_context, 'own') = 'own'
             AND p.legal_path IS NOT NULL
             AND (
                    p.legal_path = ({suffix_expr})
                 OR ends_with(p.legal_path, '.' || ({suffix_expr}))
             )
