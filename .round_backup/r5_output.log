    elif 'quy Ä‘á»‹nh háº¿t hiá»‡u lá»±c' in rel:
        return 'QUY_DINH_HET_HIEU_LUC'
    elif 'bÃ£i bá»' in rel or rel == 'vÄƒn báº£n háº¿t hiá»‡u lá»±c':
        return 'BAI_BO'
    elif 'thay tháº¿' in rel:
        return 'THAY_THE'
    elif rel == 'vÄƒn báº£n sá»­a Ä‘á»•i':
        return 'DUOC_SUA_DOI'
    elif rel == 'vÄƒn báº£n bá»• sung':
        return 'DUOC_BO_SUNG'
    elif 'sá»­a Ä‘á»•i' in rel or 'bá»• sung' in rel:
        return 'SUA_DOI_BO_SUNG'
    elif rel == 'vÄƒn báº£n hd, qÄ‘ chi tiáº¿t':
        return 'DUOC_HUONG_DAN_CHI_TIET'
    elif 'hÆ°á»›ng dáº«n' in rel or 'chi tiáº¿t' in rel:
        return 'HUONG_DAN_CHI_TIET'
    elif rel == 'vÄƒn báº£n cÄƒn cá»©':
        return 'LA_CAN_CU_CHO'
    elif 'cÄƒn cá»©' in rel:
        return 'CAN_CU'
    elif rel == 'vÄƒn báº£n dáº«n chiáº¿u':
        return 'DUOC_DAN_CHIEU'
    elif 'dáº«n chiáº¿u' in rel:
        return 'DAN_CHIEU'
    elif 'há»£p nháº¥t' in rel:
        return 'HOP_NHAT'
    elif 'Ä‘Ã­nh chÃ­nh' in rel:
        return 'DINH_CHINH'
    elif 'táº¡m ngÆ°ng' in rel:
        return 'TAM_NGUNG_HIEU_LUC'
    elif 'bá»‹ Ä‘Ã¬nh chá»‰' in rel:
        return 'BI_DINH_CHI'
    elif 'Ä‘Ã¬nh chá»‰' in rel:
        return 'DINH_CHI_THI_HANH'
    elif 'giáº£i thÃ­ch' in rel:
